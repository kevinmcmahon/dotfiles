{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(sg:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "enableAllProjectMcpServers": true,
  "skillOverrides": {
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "durable-objects": "off",
    "sandbox-migrate-to-next": "off",
    "sandbox-next": "off",
    "sandbox-sdk": "off",
    "sandbox-stable": "off",
    "turnstile-spin": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "wrangler": "off",
    "book-code-complete": "off",
    "book-domain-driven-design": "off",
    "book-domain-modeling": "off",
    "book-legacy-change": "off",
    "book-reliability-review": "off",
    "book-patterns-of-enterprise-application-architecture": "off",
    "book-the-pragmatic-programmer": "off",
    "bug-hunt-swarm": "off",
    "review-swarm": "off",
    "find-skills": "off",
    "likec4-dsl": "off",
    "runpodctl": "off",
    "terraform-diagrams": "off",
    "codex": "off",
    "app-store-changelog": "off",
    "app-store-preflight-skills": "off",
    "app-store-review": "off",
    "swift-best-practices": "off",
    "coding-best-practices": "off",
    "brainstorm": "off",
    "careful-review-2": "off",
    "do-issues": "off",
    "do-todo": "off",
    "find-missing-tests": "off",
    "gh-issue": "off",
    "make-github-issues": "off",
    "plan": "off",
    "plan-gh": "off",
    "plan-tdd": "off",
    "security-review": "off",
    "session-summary": "off",
    "setup": "off",
    "careful-review": "off",
    "code-review": "off",
    "anthropic-skills:grilling": "off",
    "anthropic-skills:writing-tropes": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ntfy-notify.sh question"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ntfy-notify.sh permission"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ntfy-notify.sh idle"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ntfy-notify.sh complete"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ntfy-notify.sh prompt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git config --local --unset core.hooksPath 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/scripts/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "modern-go-guidelines@goland-claude-marketplace": false,
    "gopls-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "workflow-skill-design@trailofbits": false,
    "astral@astral-sh": true,
    "codex@openai-codex": true,
    "telegram@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "deploy-on-aws@claude-plugins-official": false,
    "elements-of-style@the-elements-of-style": false,
    "mattpocock-skills@mattpocock": true,
    "cloudflare@cloudflare": false,
    "perplexity@pplx-search": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      }
    },
    "the-elements-of-style": {
      "source": {
        "source": "github",
        "repo": "kevinmcmahon/the-elements-of-style"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "pplx-search": {
      "source": {
        "source": "github",
        "repo": "kevinmcmahon/pplx-search"
      }
    }
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "channelsEnabled": true,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
