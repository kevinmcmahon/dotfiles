{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest"
  ],
  "model": "openai/gpt-5.3",
  "small_model": "google/gemini-3-flash-preview",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "HOPPER_LAUNCHER_PATH": "/Users/kevin/Applications/Hopper Disassembler.app/Contents/MacOS/hopper"
      }
    }
  }
}